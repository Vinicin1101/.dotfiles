{
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "default": ""
    }
  },
  "custom/host": {
    "exec": "echo $USER@$(uname -n)",
    "format": "{}"
  },
  "custom/fiap": {
    "format": "RM559144"
  },
  "group/gs": {
    "orientation": "horizontal",
    "modules": [
      "custom/host",
      "custom/separator#line",
      "custom/fiap"
    ]
  },
  "cpu": {
    "interval": 10,
    "format": "{}% ",
    "max-length": 10
  },
  "custom/temp": {
    "exec": "/home/serafim/.config/hypr/scripts/temp.py",
    "return-type": "json",
    "interval": 5,
    "format": "{}"
  },
  "memory": {
    "interval": 5,
    "format": " {used:0.1f}GB"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon} {}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "󰪑",
      "inhibited-notification": "󱏪",
      "inhibited-none": "󱏪",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "on-click": "sh -c 'sleep 0.1s; swaync-client -t -sw; sleep 0.1s'",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/pipewire": {
    "exec": "$HOME/.config/hypr/scripts/sound/volume.sh -status",
    "exec-if": true,
    "format": "{icon}{}",
    "return-type": "json",
    "escape": true,
    "interval": 3,
    "format-icons": {
      "mute": "",
      "playing": "",
      "paused": "󰏦",
      "default": ""
    },
    "max-length": 25,
    "on-click-middle": "$HOME/.config/hypr/scripts/sound/volume.sh -mute",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-",
    "on-double-click": "exec playerctl next",
    "on-double-click-right": "exec playerctl previous",
    "on-click": "exec playerctl play-pause",
    "on-click-right": "exec playerctl -p spotify play-pause"
  },
  "custom/mpd": {
    "exec": "$HOME/.config/hypr/scripts/sound/volume.sh -status",
    "exec-if": true,
    "format": "{}",
    "return-type": "json",
    "interval": 3,
    "max-length": 25,
    "on-click-middle": "$HOME/.config/hypr/scripts/sound/volume.sh -mute",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-",
    "on-double-click": "exec playerctl next",
    "on-double-click-right": "exec playerctl previous",
    "on-click": "exec playerctl play-pause",
    "on-click-right": "exec playerctl -p spotify play-pause"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "default": [
        "",
        ""
      ]
    },
    "tooltip-format": "{desc} \nVolume: {volume}%",
    "on-click": "pavucontrol"
  },
  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "exec tschuss",
    "on-click-right": "kitty 'ranger'",
    "on-click-middle": "$HOME/.config/hypr/scripts/theme/wallpapers/random.sh"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 30,
    "rewrite": {
      "(.*) - Google Chrome": " $1",
      "(.*)Netflix(.*)": "󰝆 Neflix",
      "(.*)WhatsApp(.*)": " Zap-zap",
      "(.*)Alura(.*)": "󰋀 Alura",
      "(.*)YouTube(.*)": " YouTube",
      "OBS (.*)": "OBS",
      "vim (.*)": " $1",
      "(.*) - zsh": " [$1]",
      "(.*) - Visual Studio Code": "󰨞 Visual Studio Code",
      "rofi - drun": "Launcher"
    }
  },
  "network": {
    "family": "ipv4",
    "interval": 2,
    "format": "{ifname}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰛳",
    "format-disconnected": "󰲛",
    "tooltip-format": "{ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{ifname}\t\t|\t{ipaddr}\n{essid}\t|\t{icon} {frequency}Ghz {signaldBm}dBm ({signalStrength}%) \n{bandwidthDownBits} \t|\t{bandwidthUpBits} \t|\t{cidr}",
    "tooltip-format-ethernet": "󰛳 {ifname} | {ipaddr}",
    "tooltip-format-disconnected": "󰲛 Disconnected",
    "max-length": 50,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "exec kitty nmtui"
  },
  "network#speed": {
    "family": "ipv4_6",
    "interval": 5,
    "format": "{ifname}",
    "format-wifi": "{bandwidthUpBytes}  | {bandwidthUpBytes} ",
    "format-ethernet": "󰛳",
    "format-disconnected": "󰲛",
    "tooltip-format": "{ifname} - {ipaddr}",
    "tooltip-format-wifi": "{essid}\t\t|\t {frequency}Ghz {signaldBm}dBm ({signalStrength}%)\n{ifname}\t\t|\t{ipaddr}",
    "tooltip-format-ethernet": "󰛳 {ifname} | {ipaddr}",
    "tooltip-format-disconnected": "󰲛 Disconnected",
    "max-length": 50,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "exec kitty nmtui"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format-connected": "\tDevices\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec kitty bluetui"
  },
  "custom/ollama": {
    "return-type": "json",
    "escape": true,
    "interval": 10,
    "exec-if": true,
    "exec": "$HOME/.config/hypr/scripts/ollama-status.sh",
    "format": "{}"
  },
  "custom/separator#line": {
    "format": "|",
    "interval": "once",
    "tooltip": false
  },
  "group/wireless": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "custom/separator#line",
      "bluetooth"
    ]
  },
  "group/spaces": {
    "orientatio": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "group/title": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/window"
    ]
  },
  "group/hwstats": {
    "orientation": "horizontal",
    "modules": [
      "memory",
      "custom/separator#line",
      "cpu",
      "custom/separator#line",
      "custom/temp"
    ],
    "drawer": {
      "click-to-reveal": true
    }
  },
  "group/menu": {
    "orientation": "horizontal",
    "modules": [
      "custom/logo",
      "custom/ollama",
      "group/hwstats"
    ],
    "drawer": {
      "click-to-reveal": false
    }
  },
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "custom/mpd"
    ],
    "drawer": {
      "click-to-reveal": false,
      "transition-left-to-right": false
    }
  }
}
